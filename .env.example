# Kroger developer portal (developer.kroger.com) -> your app -> Client ID / Client Secret
# App must have the "Products" (product.compact) scope enabled.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup)
FDC_API_KEY=

# 5-digit ZIP used to pick the demo Kroger-family store
DEMO_ZIP=

# Optional: pin a specific store (otherwise the first location near DEMO_ZIP is used)
DEMO_LOCATION_ID=

# Walmart I/O consumer ID (fill in after uploading secrets/walmart_public_key.pem)
WALMART_CONSUMER_ID=
